<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>spring-boot-starter-parent</artifactId>
        <groupId>org.springframework.boot</groupId>
        <version>3.5.16</version>
    </parent>
    <groupId>com.fresh</groupId>
    <artifactId>fresh-market</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <modules>
        <module>fresh-common</module>
        <module>fresh-pojo</module>
        <module>fresh-server</module>
    </modules>
    <properties>
        <mybatis.plus>3.5.12</mybatis.plus>
        <lombok>1.18.36</lombok>
        <fastjson>1.2.83</fastjson>
        <druid>1.2.23</druid>
        <pagehelper>5.3.3</pagehelper>
        <aliyun.sdk.oss>3.17.4</aliyun.sdk.oss>
        <knife4j>4.5.0</knife4j>
        <springdoc>2.8.17</springdoc>
        <!--aspectj 1.9.7 只识别到 Java 16 字节码，Boot 3 基线是 17，需 1.9.20+-->
        <aspectj>1.9.24</aspectj>
        <jjwt>0.11.5</jjwt>
        <poi>5.2.5</poi>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!--MyBatis-Plus（内含 mybatis、mybatis-spring）。
                Boot 3 起必须用 spring-boot3 专用 starter（内含 mybatis-spring 3.x，适配 Spring 6）-->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis.plus}</version>
            </dependency>

            <!--MyBatis-Plus 注解包，供 fresh-pojo 实体类使用-->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis.plus}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok}</version>
            </dependency>

            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>${fastjson}</version>
            </dependency>

            <!--Boot 3 用 druid 的 3 系 starter（同版本线，坐标不同）-->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid}</version>
            </dependency>

            <!--PageHelper 分页插件核心包
                （不引 pagehelper-spring-boot-starter：其自动配置类硬引用原生
                mybatis-spring-boot-autoconfigure 的类，与"仅用 MyBatis-Plus"的依赖结构冲突）-->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper</artifactId>
                <version>${pagehelper}</version>
            </dependency>

            <!--knife4j 4.x 改为基于 springdoc（OpenAPI3）的 jakarta 版本，注解体系从 springfox 换代-->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j}</version>
            </dependency>

            <!--钉死 springdoc 版本：knife4j 4.5.0 传递依赖的 springdoc 2.2.0 与 Boot 3.5 不兼容
                （Spring 6.2 移除了 springdoc 2.2 调用的 ControllerAdviceBean 构造器，启动即 NoSuchMethodError）-->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc}</version>
            </dependency>

            <dependency>
                <groupId>org.aspectj</groupId>
                <artifactId>aspectjrt</artifactId>
                <version>${aspectj}</version>
            </dependency>

            <dependency>
                <groupId>org.aspectj</groupId>
                <artifactId>aspectjweaver</artifactId>
                <version>${aspectj}</version>
            </dependency>

            <!--jjwt 0.11+ 拆分为 api/impl/jackson 三个包：api 编译期用，另两个运行期-->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt}</version>
            </dependency>

            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun.sdk.oss}</version>
            </dependency>

            <!-- poi：报表 Excel 导出只用 HSSF（.xls），主包即可 -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi</artifactId>
                <version>${poi}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
